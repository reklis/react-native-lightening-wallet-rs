# Java (bundled with Android Studio) - must be set first
export JAVA_HOME="/opt/android-studio/jbr"
export PATH="$JAVA_HOME/bin:$PATH"

# Android SDK
export ANDROID_HOME="$HOME/Android/Sdk"
export ANDROID_SDK_ROOT="$ANDROID_HOME"

# Android NDK
export ANDROID_NDK_HOME="$ANDROID_HOME/ndk/29.0.14033849"
export ANDROID_NDK_ROOT="$ANDROID_HOME/ndk/29.0.14033849"
export ANDROID_NDK="$ANDROID_HOME/ndk/29.0.14033849"

# Add Android SDK tools to PATH
PATH_add "$ANDROID_HOME/emulator"
PATH_add "$ANDROID_HOME/platform-tools"
PATH_add "$ANDROID_HOME/cmdline-tools/latest/bin"
PATH_add "$ANDROID_HOME/tools"
PATH_add "$ANDROID_HOME/tools/bin"

# Android Studio
export ANDROID_STUDIO="/opt/android-studio"
PATH_add "$ANDROID_STUDIO/bin"

# Force Qt to use X11 instead of Wayland for emulator
export QT_QPA_PLATFORM=xcb
